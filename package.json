{
  "name": "meeting-note-taker",
  "private": true,
  "version": "0.3.75",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run check:bundle && npm run check:security",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:build": "cross-env VITE_WDIO=true tauri build --debug --features wdio --config src-tauri/tauri.e2e.conf.json && node scripts/sign-e2e-bundle.mjs",
    "test:e2e": "node scripts/run-wdio.mjs",
    "test:e2e:baseline": "cross-env CAPTURE_BASELINES=true node scripts/run-wdio.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/cytoscape": "^3.21.9",
    "cytoscape": "^3.34.0",
    "cytoscape-d3-force": "^1.1.4",
    "lucide-react": "1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape-d3-force": "^1.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0",
    "serialize-javascript": "7.0.5"
  }
}
